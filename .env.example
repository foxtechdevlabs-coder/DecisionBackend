PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-this-to-a-long-random-string

# Supabase Postgres connection string — Supabase dashboard > Project Settings
# > Database > Connection string > "Transaction pooler" (or "Session pooler"),
# with your database password filled in. Must start with postgres:// or
# postgresql://. Example shape:
# postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Initial admin account (created on first boot if it doesn't exist yet)
ADMIN_EMAIL=admin@foxtech.com
ADMIN_PASSWORD=change-this-password
